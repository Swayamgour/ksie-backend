# Server
NODE_ENV=development
PORT=5000

# Database (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/ksie_cargo
# For MongoDB Atlas, use something like:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ksie_cargo?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Default Super Admin (used by seed script)
SUPER_ADMIN_EMAIL=admin@ksie.com
SUPER_ADMIN_PASSWORD=Admin@12345

# Uploads
MAX_UPLOAD_MB=10
UPLOAD_DIR=uploads

# Optional external integrations (enable only when vendor credentials/contracts are available)
ICEGATE_BASE_URL=
ICEGATE_CLIENT_ID=
ICEGATE_CLIENT_SECRET=
GST_IRP_BASE_URL=
GST_IRP_USERNAME=
GST_IRP_PASSWORD=
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_TOKEN=
WHATSAPP_PROVIDER_URL=
WHATSAPP_PROVIDER_TOKEN=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
